# TransitOps Backend Environment Configuration Template
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/transitops
JWT_SECRET=your_super_secret_key_at_least_32_characters_long
JWT_EXPIRES_IN=8h
CLIENT_ORIGIN=http://localhost:5173

# SMTP Email Configuration (Optional - falls back to Ethereal in development)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@example.com
SMTP_PASS=your_app_password
SMTP_FROM="TransitOps Support" <noreply@transitops.demo>
# Google OAuth 2.0 Client ID (Optional for dev, required for verified Google Sign-In)
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
